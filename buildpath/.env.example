# Django
# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# False in production
DEBUG=True
# Production: buildpath.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://buildpath.example.com
CSRF_TRUSTED_ORIGINS=

# Database
DB_NAME=buildpath_db
DB_USER=buildpath_user
DB_PASSWORD=
# Production: postgres (the shared container)
DB_HOST=localhost
DB_PORT=5432

# Riot API key, only needed to run the crawlers
API_KEY=
